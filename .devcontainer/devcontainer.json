{
    "name": "COS313 - Exam 2 Workspace",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "forwardPorts": [
        5432
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ],
            "settings": {
                "chat.disableAIFeatures": true,
                "github.copilot.enable": {
                    "*": false
                },
                "github.copilot.editor.enableAutoCompletions": false,
                "editor.inlineSuggest.enabled": false
            }
        }
    },
    "postCreateCommand": "bash .devcontainer/setup_db.sh",
    "remoteUser": "vscode",
    "containerEnv": {
        "PGHOST": "localhost",
        "PGPORT": "5432",
        "PGUSER": "admin",
        "PGPASSWORD": "LeaguePassword2026",
        "PGDATABASE": "sports_db"
    }
}
